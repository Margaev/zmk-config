#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        lang {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <51 52>;
        };
    };

    macros {
        new_macro2: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_ALT &kp SPACE>;

            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Dasha1 {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC               &kp N1  &kp N2  &kp N3  &kp N4                         &kp N5                       &kp N6   &kp N7    &kp N8     &kp N9   &kp N0    &kp MINUS
&kp GRAVE             &kp Q   &kp W   &kp E   &kp R                          &kp T                        &kp Y    &kp U     &kp I      &kp O    &kp P     &kp EQUAL
&kp LSHIFT            &kp A   &kp S   &kp D   &kp F                          &kp G                        &kp H    &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&mt LEFT_COMMAND TAB  &kp Z   &kp X   &kp C   &kp V                          &kp B      &trans    &trans  &kp N    &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp BSPC
                                      &mo 1   &mt LALT C_AL_KEYBOARD_LAYOUT  &kp SPACE  &trans    &trans  &kp RET  &kp LBKT  &kp RBKT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Dasha2 {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp CLCK    &kp F1        &kp F2        &kp F3        &kp F4                &kp F5                                  &kp F6       &kp F7        &kp F8        &kp F9  &kp F10  &kp F11
&kp TAB     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3          &bt BT_SEL 4                            &kp INT_YEN  &trans        &trans        &trans  &trans   &kp F12
&kp RSHIFT  &trans        &kp UP        &trans        &trans                &bt BT_CLR                              &trans       &kp UP        &trans        &trans  &trans   &trans
&kp RCTRL   &kp LEFT      &kp DOWN      &kp RIGHT     &trans                &new_macro2           &trans    &trans  &kp LEFT     &kp DOWN      &kp RIGHT     &trans  &trans   &kp BACKSLASH
                                        &trans        &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans    &trans  &kp C_MUTE   &kp C_VOL_DN  &kp C_VOL_UP
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
